# Multi-architecture manifest; reviewed production baseline, no browser or test tools.
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1 AS wheel
WORKDIR /build
COPY deployment/requirements-build.lock /tmp/requirements-build.lock
RUN pip install --require-hashes --only-binary=:all: -r /tmp/requirements-build.lock
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip wheel --no-deps --no-build-isolation --wheel-dir /wheel .

FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
ARG VCS_REF
LABEL org.opencontainers.image.source="https://github.com/NillRudd/campushallen-booking-bot" \
      org.opencontainers.image.revision=$VCS_REF
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 STATE_DIR=/app/state
WORKDIR /app
COPY deployment/requirements-prod.lock /tmp/requirements-prod.lock
RUN pip install --require-hashes --only-binary=:all: -r /tmp/requirements-prod.lock \
    && groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app
COPY --from=wheel /wheel /tmp/wheel
RUN pip install --no-deps --no-index /tmp/wheel/*.whl && rm -rf /tmp/wheel
COPY migrations ./migrations
COPY alembic.ini ./
COPY deployment/prod-entrypoint.sh /usr/local/bin/prod-entrypoint
RUN chmod 755 /usr/local/bin/prod-entrypoint && mkdir -p /app/state && chown app:app /app/state
USER app
EXPOSE 8000
ENTRYPOINT ["prod-entrypoint"]
CMD ["python", "-m", "uvicorn", "campushallen.web.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-proxy-headers", "--no-access-log", "--ws", "none", "--limit-concurrency", "24", "--backlog", "32"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c 'import os,urllib.request; r=urllib.request.Request("http://127.0.0.1:8000/health",headers={"Host":os.environ.get("HEALTH_HOST","campushallenbot.se")}); urllib.request.urlopen(r,timeout=3)'
