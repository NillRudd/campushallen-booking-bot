# Optional. Used by `scripts/login.py --env` when headed browser login is unavailable.
# CAMPUSHALLEN_USERNAME=
# CAMPUSHALLEN_PASSWORD=

# Optional override for config path.
# CAMPUSHALLEN_CONFIG=config.yaml

# Web application / worker (development only; CLI variables above still work).
APP_ENV=development
DEFAULT_LOCALE=sv_SE
DATABASE_URL=sqlite:///state/web.db
STATE_DIR=state
CAMPUSHALLEN_TIMEZONE=Europe/Stockholm
SECURE_COOKIES=false
SESSION_HOURS=12
WORKER_POLL_SECONDS=60
WORKER_CONCURRENCY=8

# Optional in development: absent keys are generated into private STATE_DIR files.
# Outside development, set both to strong, independent values.
# SECRET_KEY=<generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'>
# ENCRYPTION_KEY=<generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'>

# Invitation links only; no production domain is assumed.
PUBLIC_BASE_URL=http://127.0.0.1:8000
