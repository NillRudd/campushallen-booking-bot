#: src/campushallen/web/templates/invite.html:11
msgid "Choose username"
msgstr "Välj användarnamn"

#: src/campushallen/web/templates/invite.html:12
msgid "Choose website password"
msgstr "Välj lösenord för webbplatsen"

#: src/campushallen/web/templates/invite.html:13
msgid ""
"At least 12 characters. Password managers and long passphrases are "
"welcome."
msgstr ""
"Minst 12 tecken. Använd gärna en lösenordshanterare eller en lång "
"lösenfras."

#: src/campushallen/web/templates/invite.html:14
msgid "Confirm website password"
msgstr "Bekräfta lösenord för webbplatsen"

#: src/campushallen/web/templates/invite.html:15
msgid "Create account"
msgstr "Skapa konto"

#: src/campushallen/web/templates/invite.html:17
msgid "Ask the application owner for a new link."
msgstr "Be ägaren om en ny inbjudningslänk."

#: src/campushallen/web/templates/invite.html:18
msgid "Already registered? Log in"
msgstr "Har du redan ett konto? Logga in"

#: src/campushallen/web/templates/invite_created.html:2
msgid "INVITATIONS"
msgstr "INBJUDNINGAR"

#: src/campushallen/web/templates/invite_created.html:2
msgid "Save these links now."
msgstr "Inbjudan skapad. Spara länkarna nu."

#: src/campushallen/web/templates/invite_created.html:3
msgid ""
"They cannot be displayed again. Give each link to one person you want to "
"invite. Treat these links as secrets."
msgstr ""
"Länkarna visas bara nu. Dela varje länk privat med en person du vill "
"bjuda in."

#: src/campushallen/web/templates/invite_created.html:4
msgid "Invitation"
msgstr "Inbjudan"

#: src/campushallen/web/templates/invite_created.html:4
#, python-format
msgid "Invitation %(number)s link"
msgstr "Länk till inbjudan %(number)s"

#: src/campushallen/web/templates/invite_created.html:4
msgid "Link copied"
msgstr "Länken har kopierats"

#: src/campushallen/web/templates/invite_created.html:4
msgid "Select and copy the link above."
msgstr "Markera och kopiera länken ovan."

#: src/campushallen/web/templates/invite_created.html:4
msgid "Copy link"
msgstr "Kopiera länk"

#: src/campushallen/web/templates/invite_created.html:5
msgid "Return to invitation management"
msgstr "Tillbaka till inbjudningarna"

#: src/campushallen/web/templates/login.html:2
msgid "Log in · Campushallen Booker"
msgstr "Logga in · Campushallen Booker"

#: src/campushallen/web/templates/login.html:3
msgid "YOUR WEEK, BOOKED"
msgstr "PLANERA DIN TRÄNING"

#: src/campushallen/web/templates/login.html:3
msgid "Welcome back."
msgstr "Välkommen tillbaka."

#: src/campushallen/web/templates/login.html:3
msgid "Manage your Campushallen accounts and booking rules."
msgstr "Hantera dina Campushallen-konton och bokningsregler."

#: src/campushallen/web/templates/login.html:4
msgid "Account created. Log in to start connecting Campushallen."
msgstr "Ditt konto är skapat. Logga in för att ansluta ditt Campushallen-konto."

#: src/campushallen/web/templates/login.html:5
msgid "Application username"
msgstr "Användarnamn"

#: src/campushallen/web/templates/login.html:6
msgid "Password"
msgstr "Lösenord"

#: src/campushallen/web/templates/login.html:7
msgid "Log in"
msgstr "Logga in"

#: src/campushallen/web/templates/login.html:7
msgid "Ask the application owner to create your login."
msgstr "Be ägaren om en inbjudan för att skapa ett konto."

#: src/campushallen/web/templates/onboarding.html:2
msgid "GET STARTED"
msgstr "KOM IGÅNG"

#: src/campushallen/web/templates/onboarding.html:2
msgid "A few steps to your first preview."
msgstr "Kom igång med dina pass."

#: src/campushallen/web/templates/onboarding.html:2
msgid "You can leave setup at any time and return through the Get started link."
msgstr ""
"Du kan hoppa över steg och komma tillbaka när du vill via länken Kom "
"igång."

#: src/campushallen/web/templates/onboarding.html:3
msgid "1 · Website account created"
msgstr "1 · Konto på webbplatsen skapat"

#: src/campushallen/web/templates/onboarding.html:3
msgid "Connect Campushallen"
msgstr "Anslut ditt Campushallen-konto"

#: src/campushallen/web/templates/onboarding.html:3
msgid ""
"Add your account, then enter your Campushallen credentials on its "
"connection page."
msgstr ""
"Lägg till ditt konto. Logga sedan in med dina inloggningsuppgifter för "
"Campushallen på kontosidan."

#: src/campushallen/web/templates/onboarding.html:3
msgid "Manage connections"
msgstr "Hantera anslutningar"

#: src/campushallen/web/templates/onboarding.html:3
msgid "Add your first connection"
msgstr "Lägg till ditt första konto"

#: src/campushallen/web/templates/onboarding.html:4
msgid "2 · Optional"
msgstr "2 · Valfritt"

#: src/campushallen/web/templates/onboarding.html:4
msgid "Choose how to reconnect"
msgstr "Välj automatisk återanslutning"

#: src/campushallen/web/templates/onboarding.html:4
msgid ""
"Use your password once, or explicitly remember it encrypted on the server"
" for automatic reconnection. You can remove it at any time."
msgstr ""
"Välj om lösenordet bara ska användas nu eller sparas för automatisk "
"återanslutning. Det lagras krypterat på servern, visas aldrig igen och "
"kan tas bort när du vill."

#: src/campushallen/web/templates/onboarding.html:4
msgid ""
"Someone with both the database and encryption key could recover "
"remembered passwords."
msgstr ""
"Den som får tillgång till både lagrade uppgifter och krypteringsnyckeln "
"kan läsa sparade lösenord."

#: src/campushallen/web/templates/onboarding.html:5
#: src/campushallen/web/templates/onboarding.html:6
msgid "Done"
msgstr "Klart"

#: src/campushallen/web/templates/onboarding.html:5
#: src/campushallen/web/templates/rule_form.html:1
msgid "Booking rule"
msgstr "Bokningsregel"

#: src/campushallen/web/templates/onboarding.html:5
msgid "Choose your session"
msgstr "Välj vilka pass du vill boka"

#: src/campushallen/web/templates/onboarding.html:5
msgid ""
"Pick an activity, weekday, preferred time and facility. Waitlist bookings"
" are off by default."
msgstr ""
"Välj pass, veckodag, önskad starttid och anläggning. Bokning till "
"reservlista är avstängd från början."

#: src/campushallen/web/templates/onboarding.html:5
msgid "Create your first rule →"
msgstr "Skapa din första bokningsregel →"

#: src/campushallen/web/templates/onboarding.html:6
msgid "Check the match"
msgstr "Förhandsgranska dina pass"

#: src/campushallen/web/templates/onboarding.html:6
msgid ""
"Preview from an account page to see upcoming sessions and their API-"
"provided booking opening times. Previews never book."
msgstr ""
"Förhandsgranska på kontosidan för att se kommande pass och när "
"Campushallen öppnar bokningen. Tjänsten är under utveckling och "
"förhandsgranskningen gör inga bokningar."

#: src/campushallen/web/templates/onboarding.html:6
msgid "Add a connection first →"
msgstr "Lägg till ett konto först →"

#: src/campushallen/web/templates/onboarding.html:6
msgid "Continue to dashboard"
msgstr "Fortsätt till översikten"

#: src/campushallen/web/templates/onboarding.html:6
msgid "Skip setup for now"
msgstr "Hoppa över detta nu"

#: src/campushallen/web/templates/rule_form.html:2
msgid "BOOKING RULE"
msgstr "BOKNINGSREGEL"

#: src/campushallen/web/templates/rule_form.html:2
msgid "Edit rule"
msgstr "Redigera bokningsregel"

#: src/campushallen/web/templates/rule_form.html:5
msgid "Rule name"
msgstr "Regelns namn"

#: src/campushallen/web/templates/rule_form.html:5
msgid "Activity"
msgstr "Pass"

#: src/campushallen/web/templates/rule_form.html:5
msgid "Product name"
msgstr "Passets namn hos Campushallen"

#: src/campushallen/web/templates/rule_form.html:5
msgid "As shown by Campushallen"
msgstr "Som det visas hos Campushallen"

#: src/campushallen/web/templates/rule_form.html:6
msgid "Weekday"
msgstr "Veckodag"

#: src/campushallen/web/templates/rule_form.html:7
msgid "Preferred start time"
msgstr "Önskad starttid"

#: src/campushallen/web/templates/rule_form.html:8
msgid "Facility contains (comma-separated)"
msgstr "Anläggning (separera flera med kommatecken)"

#: src/campushallen/web/templates/rule_form.html:8
msgid "For example, the facility in your schedule"
msgstr "Till exempel anläggningen i ditt schema"

#: src/campushallen/web/templates/rule_form.html:9
msgid "Allow waiting-list bookings"
msgstr "Boka reservplats"

#: src/campushallen/web/templates/rule_form.html:9
msgid "Rule enabled"
msgstr "Aktiv regel"

#: src/campushallen/web/templates/rule_form.html:10
msgid "Advanced matching options"
msgstr "Avancerade inställningar"

#: src/campushallen/web/templates/rule_form.html:10
msgid ""
"When the time window is blank, use one hour on either side of your "
"preferred time. Without a preferred time, consider the whole day and "
"reject ambiguous matches."
msgstr ""
"Om tidsintervallet lämnas tomt söks pass inom en timme före och efter "
"önskad starttid. Utan önskad tid söks hela dagen. Om flera pass matchar "
"görs ingen bokning."

#: src/campushallen/web/templates/rule_form.html:11
msgid "Booking type"
msgstr "Bokningstyp"

#: src/campushallen/web/templates/rule_form.html:11
msgid "Group activity"
msgstr "Gruppass"

#: src/campushallen/web/templates/rule_form.html:11
msgid "Service (CLI only)"
msgstr "Tjänst (endast kommandoradsverktyget)"

#: src/campushallen/web/templates/rule_form.html:11
msgid "Web category ID"
msgstr "Kategori-ID i API:et"

#: src/campushallen/web/templates/rule_form.html:12
msgid "Fixed start time (optional for groups)"
msgstr "Fast starttid (valfritt för gruppass)"

#: src/campushallen/web/templates/rule_form.html:12
msgid "Earliest allowed start"
msgstr "Tidigaste tillåtna starttid"

#: src/campushallen/web/templates/rule_form.html:12
msgid "Latest allowed start"
msgstr "Senaste tillåtna starttid"

#: src/campushallen/web/templates/rule_form.html:13
msgid "Product IDs"
msgstr "Produkt-ID:n"

#: src/campushallen/web/templates/rule_form.html:13
msgid "Business unit IDs"
msgstr "Anläggnings-ID:n"

#: src/campushallen/web/templates/rule_form.html:13
msgid "Product name fragments"
msgstr "Delar av passets namn"

#: src/campushallen/web/templates/rule_form.html:13
msgid "(comma-separated)"
msgstr "(separera med kommatecken)"

#: src/campushallen/web/templates/rule_form.html:14
msgid "Save rule"
msgstr "Spara regel"

#: src/campushallen/web/templates/rule_form.html:14
msgid "Cancel"
msgstr "Avbryt"

#: src/campushallen/web/templates/rule_form.html:14
msgid "before creating a rule."
msgstr "innan du skapar en bokningsregel."

#: src/campushallen/web/templates/rules.html:1
msgid "Booking rules"
msgstr "Bokningsregler"

#: src/campushallen/web/templates/rules.html:1
msgid "AUTOMATION"
msgstr "BOKNINGAR"

#: src/campushallen/web/templates/rules.html:1
msgid "Booking rules."
msgstr "Bokningsregler."

#: src/campushallen/web/templates/rules.html:2
msgid "Edit"
msgstr "Redigera"

#: src/campushallen/web/templates/rules.html:2
msgid "Delete rule"
msgstr "Ta bort regel"

#: src/campushallen/web/templates/rules.html:2
msgid "No rules yet. Add a Campushallen account, then create your first rule."
msgstr ""
"Det finns inga bokningsregler ännu. Lägg till ett Campushallen-konto och "
"skapa din första regel."

#: src/campushallen/web/templates/settings.html:2
msgid "YOUR WEBSITE ACCOUNT"
msgstr "DITT KONTO PÅ WEBBPLATSEN"

#: src/campushallen/web/templates/settings.html:2
msgid "Security and sessions."
msgstr "Säkerhet och sessioner."

#: src/campushallen/web/templates/settings.html:3
#: src/campushallen/web/templates/settings.html:7
msgid "Change website password"
msgstr "Byt lösenord för webbplatsen"

#: src/campushallen/web/templates/settings.html:3
msgid ""
"This changes your Booker login, separate from your Campushallen "
"credentials. All sessions will be logged out."
msgstr ""
"Detta ändrar lösenordet för webbplatsen, som är skilt från ditt lösenord "
"för Campushallen. Alla sessioner loggas ut."

#: src/campushallen/web/templates/settings.html:5
msgid "Current website password"
msgstr "Nuvarande lösenord för webbplatsen"

#: src/campushallen/web/templates/settings.html:6
msgid "New website password"
msgstr "Nytt lösenord för webbplatsen"

#: src/campushallen/web/templates/settings.html:7
msgid "Confirm new website password"
msgstr "Bekräfta nytt lösenord för webbplatsen"

#: src/campushallen/web/templates/settings.html:8
msgid "Sessions"
msgstr "Sessioner"

#: src/campushallen/web/templates/settings.html:8
#, python-format
msgid "%(num)s signed-in session."
msgid_plural "%(num)s signed-in sessions."
msgstr[0] "%(num)s inloggad session."
msgstr[1] "%(num)s inloggade sessioner."

#: src/campushallen/web/templates/settings.html:8
msgid "Expired sessions are cleaned up at the next login."
msgstr "Utgångna sessioner rensas vid nästa inloggning."

#: src/campushallen/web/templates/settings.html:8
msgid "Log out all sessions"
msgstr "Logga ut alla sessioner"

#: src/campushallen/web/templates/settings.html:9
msgid "Your security events"
msgstr "Dina säkerhetshändelser"

#: src/campushallen/web/templates/settings.html:10
msgid "Delete website account"
msgstr "Ta bort konto på webbplatsen"

#: src/campushallen/web/templates/settings.html:10
msgid ""
"Removes your local connections, saved passwords, tokens, rules, booking "
"history, security events, and sessions. Campushallen bookings stay in "
"place. Used invitations remain permanently consumed."
msgstr ""
"Tar bort dina lokala anslutningar, sparade lösenord, regler, "
"bokningshistorik, säkerhetshändelser och sessioner. Dina bokningar hos "
"Campushallen finns kvar. Använda inbjudningar förblir förbrukade."

#: src/campushallen/web/templates/settings.html:10
msgid "The last active admin cannot delete their account."
msgstr "Den sista aktiva administratören kan inte ta bort sitt konto."

#: src/campushallen/web/templates/settings.html:11
msgid "Delete my local data"
msgstr "Ta bort mina lokala uppgifter"

#: src/campushallen/web/templates/settings.html:11
msgid "Delete website account and local data"
msgstr "Ta bort konto och lokala uppgifter"

