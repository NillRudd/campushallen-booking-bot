#: src/campushallen/web/presentation.py:26
#: src/campushallen/web/presentation.py:62
msgid "Connected"
msgstr "Ansluten"

#: src/campushallen/web/presentation.py:26
msgid "Not connected"
msgstr "Inte ansluten"

#: src/campushallen/web/presentation.py:30
msgid "Booked"
msgstr "Bokad"

#: src/campushallen/web/presentation.py:31
msgid "Already booked"
msgstr "Redan bokad"

#: src/campushallen/web/presentation.py:32
msgid "No matching activity found"
msgstr "Inget matchande pass hittades"

#: src/campushallen/web/presentation.py:33
msgid "Several possible activities found"
msgstr "Flera möjliga pass hittades"

#: src/campushallen/web/presentation.py:34
msgid "Activity could not be verified safely"
msgstr "Passet kunde inte verifieras säkert"

#: src/campushallen/web/presentation.py:35
msgid "Only waiting-list spots available"
msgstr "Endast reservlista tillgänglig"

#: src/campushallen/web/presentation.py:36
#: src/campushallen/web/presentation.py:66
#: src/campushallen/web/presentation.py:69
msgid "Campushallen sign-in failed"
msgstr "Inloggningen mot Campushallen misslyckades"

#: src/campushallen/web/presentation.py:37
msgid "Booking failed"
msgstr "Bokningen misslyckades"

#: src/campushallen/web/presentation.py:38
msgid "Booking could not be verified"
msgstr "Bokningen kunde inte verifieras"

#: src/campushallen/web/presentation.py:39
msgid "Dry run – no booking made"
msgstr "Testkörning – ingen bokning gjordes"

#: src/campushallen/web/presentation.py:40
msgid "Booking has not opened yet"
msgstr "Bokningen har inte öppnat ännu"

#: src/campushallen/web/presentation.py:42
msgid "Booking is already being processed"
msgstr "Bokningen behandlas redan"

#: src/campushallen/web/presentation.py:43
msgid "Not supported"
msgstr "Stöds inte"

#: src/campushallen/web/presentation.py:48
msgid "Unknown result"
msgstr "Okänt resultat"

#: src/campushallen/web/presentation.py:53
msgid "Confirmed by independent bookings check"
msgstr "Bekräftad genom en separat kontroll av bokningarna"

#: src/campushallen/web/presentation.py:55
msgid "Unconfirmed; check Campushallen before any retry"
msgstr "Inte bekräftad. Kontrollera Campushallen innan du försöker igen"

#: src/campushallen/web/presentation.py:57
msgid "Pending or interrupted; inspect later results"
msgstr "Pågår eller avbröts. Kontrollera senare resultat"

#: src/campushallen/web/presentation.py:58
msgid "No booking confirmed by this attempt"
msgstr "Ingen bokning bekräftades vid detta försök"

#: src/campushallen/web/presentation.py:63
msgid "Disconnected"
msgstr "Frånkopplad"

#: src/campushallen/web/presentation.py:70
msgid "Temporary connection problem"
msgstr "Tillfälligt anslutningsproblem"

#: src/campushallen/web/presentation.py:76
msgid "None"
msgstr "Inget"

#: src/campushallen/web/presentation.py:78
msgid "Check the connection"
msgstr "Kontrollera anslutningen"

#: src/campushallen/web/presentation.py:82
msgid "Used"
msgstr "Använd"

#: src/campushallen/web/presentation.py:83
msgid "Revoked"
msgstr "Återkallad"

#: src/campushallen/web/presentation.py:84
msgid "Expired"
msgstr "Utgången"

#: src/campushallen/web/presentation.py:85
msgid "Available"
msgstr "Tillgänglig"

#: src/campushallen/web/presentation.py:94
msgid "Worker healthy"
msgstr "Bokningsmotorn fungerar"

#: src/campushallen/web/presentation.py:95
msgid "Worker hasn't reported recently"
msgstr "Bokningsmotorn har inte rapporterat nyligen"

#: src/campushallen/web/presentation.py:96
#: src/campushallen/web/presentation.py:102
msgid "Worker disabled / not running"
msgstr "Bokningsmotorn körs inte"

#: src/campushallen/web/presentation.py:107
msgid "At least one active admin must remain."
msgstr "Det måste finnas minst en aktiv administratör kvar."

#: src/campushallen/web/presentation.py:108
msgid "Choose a different username."
msgstr "Användarnamnet är redan upptaget. Välj ett annat."

#: src/campushallen/web/presentation.py:109
msgid "Earliest time must be before latest time"
msgstr "Den tidigaste starttiden måste vara före den senaste."

#: src/campushallen/web/presentation.py:110
msgid "Login state changed; sign in again."
msgstr "Din inloggning har ändrats. Logga in igen."

#: src/campushallen/web/presentation.py:111
msgid "Name and activity must not be blank"
msgstr "Ange både ett namn på regeln och ett pass."

#: src/campushallen/web/presentation.py:112
msgid "Password changed in another session; log in again."
msgstr "Lösenordet har ändrats i en annan session. Logga in igen."

#: src/campushallen/web/presentation.py:113
msgid "Rule times must be local clock times without a timezone offset"
msgstr "Ange lokal tid utan tidszon, till exempel 18:45."

#: src/campushallen/web/presentation.py:114
msgid "Service rules require a fixed start time"
msgstr "Regler för tjänster behöver en fast starttid."

#: src/campushallen/web/presentation.py:115
msgid "Start time must be inside the allowed window"
msgstr "Starttiden måste ligga inom det tillåtna tidsintervallet."

#: src/campushallen/web/presentation.py:116
msgid ""
"The last active admin cannot be deleted. Create or promote another admin "
"first."
msgstr ""
"Den sista aktiva administratören kan inte tas bort. Skapa eller utse en "
"annan administratör först."

#: src/campushallen/web/presentation.py:117
msgid "The new website passwords do not match."
msgstr "De nya lösenorden för webbplatsen stämmer inte överens."

#: src/campushallen/web/presentation.py:118
msgid "This invitation is unavailable. Ask the owner for a new invitation."
msgstr ""
"Den här inbjudningslänken är inte längre giltig. Be ägaren om en ny "
"inbjudan."

#: src/campushallen/web/presentation.py:119
msgid "Type DELETE to confirm local account removal."
msgstr "Skriv DELETE för att bekräfta att anslutningen ska tas bort lokalt."

#: src/campushallen/web/presentation.py:120
msgid "Type DELETE to confirm local data removal."
msgstr "Skriv DELETE för att bekräfta att dina lokala uppgifter ska tas bort."

#: src/campushallen/web/presentation.py:121
msgid "Use a label of at most 120 characters and a future expiry."
msgstr "Ange en etikett med högst 120 tecken och ett giltighetsdatum i framtiden."

#: src/campushallen/web/presentation.py:122
msgid "Use a username of 1–254 characters without spaces or control characters."
msgstr ""
"Användarnamnet måste innehålla 1–254 tecken utan blanksteg eller "
"kontrolltecken."

#: src/campushallen/web/presentation.py:123
msgid "Use a website password of 12–4096 characters."
msgstr "Lösenordet för webbplatsen måste innehålla minst 12 och högst 4096 tecken."

#: src/campushallen/web/presentation.py:124
msgid "Website password is incorrect."
msgstr "Lösenordet för webbplatsen är felaktigt."

#: src/campushallen/web/presentation.py:125
msgid "Website passwords do not match."
msgstr "Lösenorden för webbplatsen stämmer inte överens."

#: src/campushallen/web/presentation.py:133
msgid "Unable to complete the request. Check the form and try again."
msgstr ""
"Det gick inte att slutföra åtgärden. Kontrollera formuläret och försök "
"igen."

#: src/campushallen/web/presentation.py:138
msgid ""
"A previous live attempt exists; inspect booking history before any manual"
" retry."
msgstr ""
"Ett tidigare bokningsförsök finns. Kontrollera historiken och "
"Campushallen innan du försöker igen manuellt."

#: src/campushallen/web/presentation.py:139
msgid "API booking opening time has not arrived."
msgstr "Bokningen har inte öppnat hos Campushallen ännu."

#: src/campushallen/web/presentation.py:140
msgid "API did not supply bookableEarliest; no booking sent."
msgstr "Campushallen angav ingen öppningstid. Ingen bokning skickades."

#: src/campushallen/web/presentation.py:141
msgid "Account was removed"
msgstr "Kontot har tagits bort"

#: src/campushallen/web/presentation.py:142
msgid "Account, user, or rule is disabled."
msgstr "Kontot, användaren eller bokningsregeln är inaktiv."

#: src/campushallen/web/presentation.py:143
msgid "Activity discovery failed; try again later."
msgstr "Det gick inte att hämta pass. Försök igen senare."

#: src/campushallen/web/presentation.py:144
msgid "Activity has already started."
msgstr "Passet har redan börjat."

#: src/campushallen/web/presentation.py:145
msgid "Activity is already booked."
msgstr "Passet är redan bokat."

#: src/campushallen/web/presentation.py:146
msgid "Booking could not be completed."
msgstr "Bokningen kunde inte slutföras."

#: src/campushallen/web/presentation.py:147
msgid "Booking independently verified."
msgstr "Bokningen har bekräftats genom en separat kontroll."

#: src/campushallen/web/presentation.py:148
msgid "Campushallen request failed; no booking confirmed."
msgstr "Det gick inte att kontakta Campushallen. Ingen bokning har bekräftats."

#: src/campushallen/web/presentation.py:149
msgid "Dry-run; no booking sent."
msgstr "Testkörning. Ingen bokning skickades."

#: src/campushallen/web/presentation.py:150
msgid "Fixed start time no longer matches."
msgstr "Den fasta starttiden stämmer inte längre."

#: src/campushallen/web/presentation.py:151
msgid ""
"Live request reserved; an interrupted request requires manual "
"verification."
msgstr ""
"Bokningsförsöket har påbörjats. Om det avbryts behöver bokningen "
"kontrolleras manuellt."

#: src/campushallen/web/presentation.py:152
msgid "Matching activity discovered."
msgstr "Ett matchande pass hittades."

#: src/campushallen/web/presentation.py:153
msgid "No regular spots available; no booking sent."
msgstr "Det finns inga ordinarie platser kvar. Ingen bokning skickades."

#: src/campushallen/web/presentation.py:154
msgid "No safe upcoming target with API bookableEarliest was found."
msgstr "Inget kommande pass med säker matchning och angiven öppningstid hittades."

#: src/campushallen/web/presentation.py:155
msgid "No unique safe target was selected."
msgstr "Det gick inte att välja ett entydigt och säkert matchande pass."

#: src/campushallen/web/presentation.py:156
msgid "Queued target changed; no booking sent."
msgstr "Passet ändrades medan försöket väntade. Ingen bokning skickades."

#: src/campushallen/web/presentation.py:157
msgid "Reconnect this Campushallen account."
msgstr "Återanslut det här Campushallen-kontot."

#: src/campushallen/web/presentation.py:158
msgid "Request outcome is uncertain; check Campushallen before retrying."
msgstr "Resultatet är osäkert. Kontrollera Campushallen innan du försöker igen."

#: src/campushallen/web/presentation.py:159
msgid ""
"Request sent but booking could not be verified. Check Campushallen before"
" retrying."
msgstr ""
"Förfrågan skickades men bokningen kunde inte bekräftas. Kontrollera "
"Campushallen innan du försöker igen."

#: src/campushallen/web/presentation.py:160
msgid "Selection is ambiguous or outside the allowed time window."
msgstr ""
"Flera pass matchar, eller så ligger passet utanför det tillåtna "
"tidsintervallet."

#: src/campushallen/web/presentation.py:161
msgid "Service booking is available only through the legacy CLI."
msgstr "Tjänster kan bara bokas via det befintliga kommandoradsverktyget."

#: src/campushallen/web/presentation.py:162
msgid ""
"Service rules remain available through the legacy CLI; web worker does "
"not book services."
msgstr ""
"Regler för tjänster kan användas via kommandoradsverktyget. Webbplatsens "
"bokningsmotor bokar inte tjänster."

#: src/campushallen/web/presentation.py:170
msgid "See the result and check Campushallen if you are unsure."
msgstr "Se resultatet och kontrollera Campushallen om du är osäker."

#: src/campushallen/web/presentation.py:175
msgid "Website sign-in failed"
msgstr "Inloggning på webbplatsen misslyckades"

#: src/campushallen/web/presentation.py:176
msgid "Website sign-in temporarily locked"
msgstr "Inloggningen på webbplatsen är tillfälligt låst"

#: src/campushallen/web/presentation.py:177
msgid "Website sign-in successful"
msgstr "Inloggning på webbplatsen lyckades"

#: src/campushallen/web/presentation.py:178
msgid "Website sign-in lock expired"
msgstr "Inloggningsspärren på webbplatsen har gått ut"

#: src/campushallen/web/presentation.py:179
msgid "User registered"
msgstr "Användare registrerad"

#: src/campushallen/web/presentation.py:180
msgid "User created"
msgstr "Användare skapad"

#: src/campushallen/web/presentation.py:181
msgid "User deleted"
msgstr "Användare borttagen"

#: src/campushallen/web/presentation.py:182
msgid "Admin promoted"
msgstr "Administratör utsedd"

#: src/campushallen/web/presentation.py:183
msgid "Admin demoted"
msgstr "Administratörsbehörighet borttagen"

#: src/campushallen/web/presentation.py:184
msgid "Login success"
msgstr "Inloggning lyckades"

#: src/campushallen/web/presentation.py:185
msgid "Login failed"
msgstr "Inloggning misslyckades"

#: src/campushallen/web/presentation.py:186
msgid "Logout"
msgstr "Utloggning"

#: src/campushallen/web/presentation.py:187
msgid "Sessions revoked"
msgstr "Alla sessioner avslutade"

#: src/campushallen/web/presentation.py:188
msgid "Password changed"
msgstr "Lösenord ändrat"

#: src/campushallen/web/presentation.py:189
msgid "Campushallen connected"
msgstr "Ansluten till Campushallen"

#: src/campushallen/web/presentation.py:190
msgid "Campushallen reconnected"
msgstr "Återansluten till Campushallen"

#: src/campushallen/web/presentation.py:191
msgid "Account disabled"
msgstr "Konto inaktiverat"

#: src/campushallen/web/presentation.py:192
msgid "Account enabled"
msgstr "Konto aktiverat"

#: src/campushallen/web/presentation.py:193
msgid "Account disconnected"
msgstr "Konto frånkopplat"

#: src/campushallen/web/presentation.py:194
msgid "Account deleted"
msgstr "Konto borttaget"

#: src/campushallen/web/presentation.py:195
msgid "Stored credential enabled"
msgstr "Inloggningsuppgifter sparade"

#: src/campushallen/web/presentation.py:196
msgid "Stored credential removed"
msgstr "Sparat lösenord borttaget"

#: src/campushallen/web/presentation.py:197
msgid "Stored credential replaced"
msgstr "Sparat lösenord ersatt"

#: src/campushallen/web/presentation.py:198
msgid "Booking rule created"
msgstr "Bokningsregel skapad"

#: src/campushallen/web/presentation.py:199
msgid "Booking rule updated"
msgstr "Bokningsregel uppdaterad"

#: src/campushallen/web/presentation.py:200
msgid "Booking rule deleted"
msgstr "Bokningsregel borttagen"

#: src/campushallen/web/presentation.py:201
msgid "Invite created"
msgstr "Inbjudan skapad"

#: src/campushallen/web/presentation.py:202
msgid "Invite used"
msgstr "Inbjudan använd"

#: src/campushallen/web/presentation.py:203
msgid "Invite revoked"
msgstr "Inbjudan återkallad"

#: src/campushallen/web/presentation.py:204
msgid "Token expired"
msgstr "Anslutningen har gått ut"

#: src/campushallen/web/presentation.py:205
msgid "Reauth success"
msgstr "Automatisk återanslutning lyckades"

#: src/campushallen/web/presentation.py:206
msgid "Reauth failed"
msgstr "Automatisk återanslutning misslyckades"

#: src/campushallen/web/presentation.py:207
msgid "Reconnect required"
msgstr "Återanslutning krävs"

#: src/campushallen/web/presentation.py:212
msgid "Security event"
msgstr "Säkerhetshändelse"

#: src/campushallen/web/presentation.py:227
msgid "Enter a rule name (1–120 characters) and an activity (1–200 characters)."
msgstr "Ange ett regelnamn med 1–120 tecken och ett pass med 1–200 tecken."

#: src/campushallen/web/presentation.py:230
msgid "Choose a weekday from Monday to Sunday."
msgstr "Välj en veckodag från måndag till söndag."

#: src/campushallen/web/presentation.py:232
msgid "Choose a valid booking type."
msgstr "Välj en giltig bokningstyp."

#: src/campushallen/web/presentation.py:234
msgid "Enter numeric IDs. The category ID must be greater than zero."
msgstr "Ange numeriska ID:n. Kategori-ID måste vara större än noll."

#: src/campushallen/web/presentation.py:236
msgid "Use at most 30 facility filters."
msgstr "Ange högst 30 anläggningsfilter."

#: src/campushallen/web/presentation.py:238
msgid "Enter valid local times, for example 18:45, without a timezone."
msgstr "Ange giltiga lokala tider utan tidszon, till exempel 18:45."

#: src/campushallen/web/routes/accounts.py:33
msgid "Enter an account name and Campushallen username."
msgstr "Ange ett kontonamn och ditt användarnamn hos Campushallen."

#: src/campushallen/web/routes/accounts.py:38
msgid "That account is already added."
msgstr "Det här kontot har redan lagts till."

#: src/campushallen/web/routes/accounts.py:58
msgid "Too many connection attempts. Try again in five minutes."
msgstr "För många anslutningsförsök. Försök igen om fem minuter."

#: src/campushallen/web/routes/accounts.py:61
msgid "Enter the Campushallen password."
msgstr "Ange ditt lösenord för Campushallen."

#: src/campushallen/web/routes/accounts.py:79
msgid "Connection failed. Check your credentials or try again later."
msgstr ""
"Kunde inte logga in på Campushallen. Kontrollera användarnamn och "
"lösenord eller försök igen senare."

#: src/campushallen/web/routes/accounts.py:135
msgid "Confirm disconnect to remove local tokens and saved credentials."
msgstr ""
"Bekräfta frånkopplingen för att ta bort anslutningen och sparade "
"inloggningsuppgifter lokalt."

#: src/campushallen/web/routes/accounts.py:145
#: src/campushallen/web/routes/security.py:36
#: src/campushallen/web/routes/security.py:59
msgid "Too many attempts. Try again shortly."
msgstr "För många försök. Vänta en stund och försök igen."

#: src/campushallen/web/routes/admin.py:43
msgid "Too many requests. Try again shortly."
msgstr "För många förfrågningar. Vänta en stund och försök igen."

#: src/campushallen/web/routes/admin.py:64
msgid ""
"Use 1–100 invites, a label up to 120 characters, and 0–365 expiry days (0"
" means no expiry)."
msgstr ""
"Ange 1–100 inbjudningar, en etikett med högst 120 tecken och 0–365 dagars"
" giltighet (0 betyder utan slutdatum)."

#: src/campushallen/web/routes/auth.py:44
msgid "Too many failed sign-in attempts. Try again in 30 minutes."
msgstr "För många misslyckade inloggningsförsök. Försök igen om 30 minuter."

#: src/campushallen/web/routes/auth.py:46
msgid "Invalid username or password."
msgstr "Felaktigt användarnamn eller lösenord."

#: src/campushallen/web/routes/auth.py:61
msgid "Login state changed. Please sign in again."
msgstr "Din inloggning har ändrats. Logga in igen."

#: src/campushallen/web/routes/invites.py:16
msgid "Too many attempts. Try again in five minutes."
msgstr "För många försök. Försök igen om fem minuter."

