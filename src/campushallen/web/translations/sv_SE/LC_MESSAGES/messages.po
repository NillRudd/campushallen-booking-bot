#: src/campushallen/web/templates/settings.html:10
msgid ""
"Removes your local connections, saved passwords, tokens, rules, booking history, security events,"
" and sessions. Campushallen bookings stay in place. Used invitations remain permanently consumed."
msgstr ""
"Tar bort dina lokala anslutningar, sparade lösenord, regler, bokningshistorik, säkerhetshändelser"
" och sessioner. Dina bokningar hos Campushallen finns kvar. Använda inbjudningar förblir "
"förbrukade."

#: src/campushallen/web/templates/settings.html:10
msgid "The last active admin cannot delete their account."
msgstr "Den sista aktiva administratören kan inte ta bort sitt konto."

#: src/campushallen/web/templates/settings.html:11
