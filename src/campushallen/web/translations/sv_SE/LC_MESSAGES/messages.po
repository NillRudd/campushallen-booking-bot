msgid "Reconnect this Campushallen account."
msgstr "Återanslut det här Campushallen-kontot."

#: src/campushallen/web/presentation.py:168
msgid "Request outcome is uncertain; check Campushallen before retrying."
msgstr "Resultatet är osäkert. Kontrollera Campushallen innan du försöker igen."

#: src/campushallen/web/presentation.py:169
msgid "Request sent but booking could not be verified. Check Campushallen before retrying."
msgstr ""
"Förfrågan skickades men bokningen kunde inte bekräftas. Kontrollera Campushallen innan du "
"försöker igen."

#: src/campushallen/web/presentation.py:170
