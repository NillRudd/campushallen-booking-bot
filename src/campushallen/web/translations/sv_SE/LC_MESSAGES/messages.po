#: src/campushallen/web/app.py:135
msgid "Page not found."
msgstr "Sidan hittades inte."

#: src/campushallen/web/app.py:136
msgid "This action is not allowed."
msgstr "Åtgärden är inte tillåten."

#: src/campushallen/web/app.py:145 src/campushallen/web/app.py:151
#: src/campushallen/web/ingress.py:31
msgid "Invalid request. Check the form and try again."
msgstr "Kontrollera formuläret och försök igen."

#: src/campushallen/web/app.py:157
msgid "Something went wrong. Please try again later."
msgstr "Något gick fel. Försök igen senare."

#: src/campushallen/web/dependencies.py:47
msgid "Account not found"
msgstr "Kontot hittades inte"

#: src/campushallen/web/dependencies.py:58
msgid "Rule not found"
msgstr "Bokningsregeln hittades inte"

#: src/campushallen/web/dependencies.py:67
msgid "Invalid CSRF token. Reload the form and try again."
msgstr "Formuläret kunde inte verifieras. Ladda om sidan och försök igen."

#: src/campushallen/web/dependencies.py:71
msgid "Expired CSRF token. Reload the form and try again."
msgstr "Formuläret har gått ut. Ladda om sidan och försök igen."

#: src/campushallen/web/dependencies.py:85
msgid "Campushallen connection updated."
msgstr "Anslutningen till Campushallen har uppdaterats."

#: src/campushallen/web/dependencies.py:86
msgid "Saved password removed. Your current token is kept."
msgstr "Det sparade lösenordet har tagits bort. Du är fortfarande ansluten."

#: src/campushallen/web/dependencies.py:87
msgid "Local authentication data removed. Campushallen bookings were kept."
msgstr ""
"Anslutningen har tagits bort lokalt. Dina bokningar hos Campushallen "
"finns kvar."

#: src/campushallen/web/dependencies.py:88
msgid "Booking rule saved."
msgstr "Bokningsregeln har sparats."

#: src/campushallen/web/dependencies.py:89
msgid "Local data removed."
msgstr "Lokala uppgifter har tagits bort."

#: src/campushallen/web/dependencies.py:90
msgid "Settings updated."
msgstr "Inställningarna har uppdaterats."

#: src/campushallen/web/dependencies.py:112
msgid "Administrator access required."
msgstr "Du behöver vara administratör för att öppna sidan."

#: src/campushallen/web/ingress.py:37
msgid "Use HTTPS to access this website."
msgstr "Använd HTTPS för att öppna webbplatsen."

#: src/campushallen/web/ingress.py:56
msgid "The form origin could not be verified. Reload the page and try again."
msgstr ""
"Formulärets ursprung kunde inte verifieras. Ladda om sidan och försök "
"igen."

#: src/campushallen/web/middleware.py:23 src/campushallen/web/middleware.py:35
msgid "Request body too large."
msgstr "Formuläret är för stort. Minska innehållet och försök igen."

